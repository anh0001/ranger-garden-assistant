[Unit]
Description=Setup CAN interface for Ranger Base (can0)
After=network.target
BindsTo=sys-subsystem-net-devices-can0.device
After=sys-subsystem-net-devices-can0.device

[Service]
Type=oneshot
RemainAfterExit=yes
# Wait a moment for device to stabilize
ExecStartPre=/bin/sleep 1
# Bring interface down (in case it was up)
ExecStartPre=-/sbin/ip link set can0 down
# Configure bitrate for Ranger base (500 kbps)
ExecStart=/sbin/ip link set can0 type can bitrate 500000
# Bring interface up
ExecStart=/sbin/ip link set can0 up
# Cleanup on stop
ExecStop=/sbin/ip link set can0 down

[Install]
WantedBy=multi-user.target
