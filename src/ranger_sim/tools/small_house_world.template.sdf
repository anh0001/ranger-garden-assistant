<?xml version="1.0" ?>
<!--
  Small-house dining room for the Ranger Mini 3.0 + PiPER pick-and-place demo
  (scene `small_house`, config/pick_place_scenes.yaml). Designed for Gazebo
  Fortress.

  Assets:
    - AWS RoboMaker Small House World furniture (Copyright 2019 Amazon.com,
      Inc., MIT-0), via TeamSOBITS/aws_small_house_world (Humble/Fortress port);
    - Google Scanned Objects (Copyright 2020 Google LLC, CC BY 4.0) wrapped by
      models/{vitamin_bottle,supplement_bottle,sprinkles_jar}.
  Fetched, not committed: python3 src/ranger_sim/tools/fetch_sim_assets.py.
  Attribution: models/THIRD_PARTY_ASSETS.md.

  The house is moved onto the robot, not the robot into the house: the robot
  still spawns at the world origin facing +x, and the kitchen table lands in
  front of it with its front edge at world x = 0.90, as in garden_world.

  worlds/small_house_world.sdf is GENERATED from
  tools/small_house_world.template.sdf by tools/generate_small_house_world.py,
  which inserts the transformed house models and lights at the GENERATED
  marker. Edit the template, then regenerate; never edit the world itself.
-->
<sdf version="1.8">
  <world name="small_house">

    <!-- Physics (as garden_world) -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Required system plugins (as garden_world) -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Lighting (as garden_world; the house's own lights follow below) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.3 0.3 0.35 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.5 -0.3 -0.7</direction>
    </light>

    <!-- Ground plane: collision only, the house FloorB is the visible floor. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Table (work surface for pick-place)                          -->
    <!-- ============================================================ -->
    <model name="table">
      <static>true</static>
      <!-- AWS KitchenTable_01 at the robot's approach: front (visual) edge at
           world x = 0.90, as in garden_world. Its visual top is 0.801 m but
           its collision mesh top is 0.8185 m, so primitives replace it
           (objects would float 1.75 cm above the visible top). Visual
           0.70 x 1.80 m, slab 0.745..0.801 m; legs ~0.09 m square at model
           (+-0.21, +-0.695). The generator drops the house's own
           KitchenTable_01_001 and anchors the house to this pose. -->
      <pose>1.25 -0.30 0 0 0 3.141593</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.773 0 0 0</pose>
          <geometry><box><size>0.70 1.80 0.056</size></box></geometry>
        </collision>
        <collision name="leg1"><pose>0.21 0.695 0.3725 0 0 0</pose><geometry><box><size>0.09 0.09 0.745</size></box></geometry></collision>
        <collision name="leg2"><pose>-0.21 0.695 0.3725 0 0 0</pose><geometry><box><size>0.09 0.09 0.745</size></box></geometry></collision>
        <collision name="leg3"><pose>0.21 -0.695 0.3725 0 0 0</pose><geometry><box><size>0.09 0.09 0.745</size></box></geometry></collision>
        <collision name="leg4"><pose>-0.21 -0.695 0.3725 0 0 0</pose><geometry><box><size>0.09 0.09 0.745</size></box></geometry></collision>
        <visual name="visual">
          <geometry><mesh><uri>model://aws_robomaker_residential_KitchenTable_01/meshes/aws_KitchenTable_01_visual.DAE</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Kitchen counter (place target of the transfer)               -->
    <!-- ============================================================ -->
    <model name="kitchen_counter">
      <static>true</static>
      <!-- AWS KitchenCabinet_01, L-shaped: the south leg along the kitchen
           wall, the west leg (sink) along the west wall. The visual stays at
           the pose the generator gives the house's KitchenCabinet_01_001,
           which it drops. Its visible top is 0.9044 m but its 32-vertex
           collision hull tops out at 0.909-0.913 m (and covers the faucet),
           so primitives replace it, as for the table. Measured from the
           visual mesh in the world frame: top slab z 0.854..0.904, south
           leg x -5.164..-1.940, y -3.016..-2.416 (its front face in front of
           the robot's lane at x -4.45..-3.55, drawer handles included; the
           top overhangs it by up to 7 mm), west leg face x -4.540, y up to
           -0.418. World-axis-aligned boxes in a zero model pose: the mesh
           is 0.29 deg off square, so each face is taken at its proud end. -->
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <!-- South leg top slab: the place surface (test_pick_place_geometry.py reads top_collision). -->
        <collision name="top_collision">
          <pose>-3.552 -2.716 0.879 0 0 0</pose>
          <geometry><box><size>3.224 0.600 0.050</size></box></geometry>
        </collision>
        <collision name="south_body"><pose>-3.552 -2.716 0.427 0 0 0</pose><geometry><box><size>3.224 0.600 0.854</size></box></geometry></collision>
        <collision name="west_leg"><pose>-4.852 -1.417 0.452 0 0 0</pose><geometry><box><size>0.624 1.998 0.904</size></box></geometry></collision>
        <visual name="visual">
          <pose>-3.547237 -1.717371 0.012074 0.000000 0.000000 1.565722</pose>
          <geometry><mesh><uri>model://aws_robomaker_residential_KitchenCabinet_01/meshes/aws_KitchenCabinet_01_visual.DAE</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Graspable objects on the table (GSO wrappers, origin = bottom) -->
    <!-- ============================================================ -->
    <!-- Pick target: on the robot's line (y = 0), 3.5 cm in from the table
         edge so the bottle's near face (x 0.908) does not overhang. The pads
         straddle it with the base at world x = 0.535
         (config/pick_place_scenes.yaml; test_pick_place_geometry.py checks
         the clearances). -->
    <include>
      <name>vitamin_bottle</name>
      <uri>model://vitamin_bottle</uri>
      <pose>0.935 0 0.801 0 0 0</pose>
    </include>
    <!-- Dressing, >= 0.30 m off the arm's plane (y = 0): clear of the fingers. -->
    <include>
      <name>supplement_bottle</name>
      <uri>model://supplement_bottle</uri>
      <pose>1.12 -0.40 0.801 0 0 0.4</pose>
    </include>
    <include>
      <name>sprinkles_jar</name>
      <uri>model://sprinkles_jar</uri>
      <pose>1.08 0.30 0.801 0 0 0</pose>
    </include>

    <!-- GENERATED: HOUSE -->

  </world>
</sdf>
