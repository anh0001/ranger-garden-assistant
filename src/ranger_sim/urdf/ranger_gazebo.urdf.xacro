<?xml version="1.0" encoding="utf-8"?>
<!--
  Gazebo Fortress wrapper for the Ranger Mini 3.0 + PiPER arm.

  Includes the real robot description (with Gazebo Classic plugin disabled)
  and adds:
    - Gazebo Fortress ros2_control plugin (gz_ros2_control) for the arm
    - True holonomic base (VelocityControl + OdometryPublisher) matching
      the real swerve robot, so the shipped Omni MPPI tuning is exercised
    - Simulated Livox-style lidar
    - Simulated front camera (fisheye approximation)
    - Simulated wrist RGBD camera
    - Simulated IMU
-->
<robot name="ranger_mini_complete" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="mesh_dir" default="package://ranger_description/meshes"/>
  <xacro:arg name="piper_mesh_dir" default="package://piper_description/meshes"/>
  <xacro:arg name="sim_gazebo_classic" default="false"/>
  <xacro:arg name="gz_controller_config" default="$(find ranger_sim)/config/ros2_controllers_sim.yaml"/>

  <!-- Include the real robot URDF with Gazebo Classic plugin disabled.
       The sim_gazebo_classic arg above (default=false) overrides the
       default=true in ranger_complete so the Classic plugin is omitted. -->
  <xacro:include filename="$(find ranger_description)/urdf/ranger_complete.urdf.xacro"/>

  <!-- ================================================================== -->
  <!-- ros2_control: Gazebo Fortress hardware interface for the PiPER arm -->
  <!-- ================================================================== -->
  <ros2_control name="GazeboFortressSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- Arm joints 1-6 -->
    <joint name="piper_joint1">
      <command_interface name="position"><param name="min">-2.618</param><param name="max">2.618</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint2">
      <command_interface name="position"><param name="min">0.0</param><param name="max">3.14</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint3">
      <command_interface name="position"><param name="min">-2.967</param><param name="max">0.0</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint4">
      <command_interface name="position"><param name="min">-1.745</param><param name="max">1.745</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint5">
      <command_interface name="position"><param name="min">-1.22</param><param name="max">1.22</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint6">
      <command_interface name="position"><param name="min">-2.0944</param><param name="max">2.0944</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Gripper -->
    <joint name="piper_joint7">
      <command_interface name="position"><param name="min">0.0</param><param name="max">0.75</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint8">
      <command_interface name="position"><param name="min">-0.75</param><param name="max">0.0</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Fortress system plugin to load the ros2_control hardware -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(arg gz_controller_config)</parameters>
      <controller_manager_name>controller_manager</controller_manager_name>
    </plugin>
  </gazebo>

  <!-- Grasp-fix is handled by the grasp_magnet node (pose-follow virtual
       attach via the Gazebo /world/<world>/set_pose service), not a
       DetachableJoint plugin: in Fortress DetachableJoint starts attached
       and drags the object off the table before any ROS node can detach
       it, and its Empty trigger / state topics did not bridge reliably.
       See scripts/grasp_magnet.py. -->

  <!-- ================================================================== -->
  <!-- Base mobility: TRUE HOLONOMIC sim base (matches real swerve robot)  -->
  <!--                                                                    -->
  <!-- The real Ranger Mini 3.0 is omnidirectional (swerve wheels): it    -->
  <!-- translates in any direction (vx, vy) and rotates (wz). To exercise  -->
  <!-- the SAME RotationShim + MPPI "Omni" tuning we ship for hardware     -->
  <!-- (robofi_bringup/config/nav2_params.yaml) without faking a mecanum   -->
  <!-- or a full swerve drivetrain, the sim base is driven kinematically: -->
  <!--   * VelocityControl   - consumes full vx,vy,wz from /cmd_vel       -->
  <!--   * OdometryPublisher  - emits /odom + odom->base_footprint TF      -->
  <!-- (dimensions=2 -> planar). This is why the earlier MecanumDrive      -->
  <!-- attempt produced no odom/TF: MecanumDrive has no odom publisher;    -->
  <!-- OdometryPublisher is the missing piece. nav2_sim.yaml stays Omni    -->
  <!-- with nonzero vy - no controller behavior change needed.            -->
  <!-- ================================================================== -->
  <gazebo>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl">
      <topic>/cmd_vel</topic>
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Navigation 2D LiDAR (sim-only)                                     -->
  <!--                                                                    -->
  <!-- The "Livox approximation" sensor below is 3D and the real lidar    -->
  <!-- mount is pitched 45 deg (rpy 0 pi/4 0), so it is unsuitable for a   -->
  <!-- flat 2D Nav2 costmap. This dedicated horizontal single-ring        -->
  <!-- gpu_lidar (1 vertical sample) makes Gazebo emit a real LaserScan   -->
  <!-- on gz topic /scan, bridged 1:1 to ROS /scan (sensor_msgs/          -->
  <!-- LaserScan) - exactly what nav2_sim.yaml's obstacle_layer expects.  -->
  <!-- Mounted level on base_link at 0.30 m so it intersects furniture    -->
  <!-- (boxes modeled solid from the floor up). SIM ONLY: the real robot  -->
  <!-- uses the Livox 3D + FASTLIO2 + STVL stack.                         -->
  <!-- ================================================================== -->
  <link name="nav_scan_link"/>
  <joint name="nav_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nav_scan_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>

  <gazebo reference="nav_scan_link">
    <sensor name="nav_scan" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <gz_frame_id>nav_scan_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Simulated LiDAR (Livox Mid-360 approximation)                     -->
  <!-- 360 deg horizontal, ~59 deg vertical, ~200k pts/s                 -->
  <!-- 3D cloud for perception fidelity; NOT used by the Nav2 costmap     -->
  <!-- (see the dedicated 2D nav_scan above). Published gz-side only.     -->
  <!-- ================================================================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>lidar/points</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Simulated IMU (co-located with LiDAR, as on real robot)            -->
  <!-- ================================================================== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Simulated front camera (Tier IV C2-176 fisheye approximation)      -->
  <!-- Standard pinhole camera; fisheye distortion is not modeled in v1.  -->
  <!-- ================================================================== -->
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>2.79</horizontal_fov>
        <image>
          <width>720</width>
          <height>465</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Simulated wrist RGBD camera (RealSense D405 approximation)         -->
  <!-- ================================================================== -->
  <gazebo reference="piper_camera_link">
    <sensor name="wrist_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>piper/wrist_camera</topic>
      <camera>
        <horizontal_fov>1.5009</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <gz_frame_id>piper_camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
