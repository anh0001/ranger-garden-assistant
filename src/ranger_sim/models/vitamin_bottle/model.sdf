<?xml version="1.0" ?>
<!-- Graspable wrapper around Google Scanned Objects "AllergenFree_JarroDophilus"
     (CC BY 4.0, Google LLC; fetched by tools/fetch_sim_assets.py, see
     models/THIRD_PARTY_ASSETS.md). The scan's own SDF has no inertia and uses
     its full mesh as collision: here the visual is the scan, the collision a
     primitive cylinder and the inertia a solid cylinder. Origin = bottom centre
     (as in the scan): place the model with z = surface height. Diameter x height
     54 x 96 mm fits the 70 mm PiPER opening with 8 mm clearance per side. -->
<sdf version="1.8">
  <model name="vitamin_bottle">
    <link name="link">
      <inertial>
        <pose>0 0 0.048 0 0 0</pose>
        <mass>0.10</mass>
        <inertia><ixx>9.503e-05</ixx><iyy>9.503e-05</iyy><izz>3.645e-05</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.048 0 0 0</pose>
        <geometry><cylinder><radius>0.027</radius><length>0.096</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://AllergenFree_JarroDophilus/meshes/model.obj</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
