<!-- Graspable wrapper around Google Scanned Objects "Wilton_Pearlized_Sugar_Sprinkles_525_oz_Gold"
     (CC BY 4.0, Google LLC; fetched by tools/fetch_sim_assets.py, see
     models/THIRD_PARTY_ASSETS.md). The scan's own SDF has no inertia and uses
     its full mesh as collision: here the visual is the scan, the collision a
     primitive cylinder and the inertia a solid cylinder. Origin = bottom centre
     (as in the scan): place the model with z = surface height. Diameter x height
     46 x 134 mm fits the 70 mm PiPER opening with 12 mm clearance per side. -->
<sdf version="1.8">
  <model name="sprinkles_jar">
    <link name="link">
      <inertial>
        <pose>0 0 0.067 0 0 0</pose>
        <mass>0.15</mass>
        <inertia><ixx>2.443e-04</ixx><iyy>2.443e-04</iyy><izz>3.968e-05</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.067 0 0 0</pose>
        <geometry><cylinder><radius>0.023</radius><length>0.134</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://Wilton_Pearlized_Sugar_Sprinkles_525_oz_Gold/meshes/model.obj</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
