<?xml version="1.0"?>
<!--
  Static, collision-free camera rig for recording the pick-and-place demo
  (launch/record_pick_place_video.launch.py, scripts/record_demo_video.py).
  Spawned at the world origin, so the sensor poses are world poses. They are
  tuned to the table and cup of worlds/garden_world.sdf; other worlds need
  their own poses. The wide camera's topic/size must match the recorder
  defaults (checked by test/test_video_rig_launch.py).
-->
<sdf version="1.8">
  <model name="video_rig">
    <static>true</static>
    <link name="link">
      <!-- Wide 3/4 view from the +y side: base approach, arm, table front and cup. -->
      <sensor name="wide_cam" type="camera">
        <pose>0.55 2.70 2.00 0 0.4777 -1.5153</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>video/wide</topic>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30</far></clip>
        </camera>
      </sensor>
      <!-- Close-up of the cup and the hovering gripper (drawn as the inset). -->
      <sensor name="close_cam" type="camera">
        <pose>0.95 0.75 1.00 0 0.0666 -1.5975</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>video/close</topic>
        <camera>
          <horizontal_fov>0.95</horizontal_fov>
          <image><width>960</width><height>540</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>10</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
